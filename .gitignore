# Local Python and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Patient data: never commit raw/processed data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Reusable large local training caches (never commit)
data/cache/

# Model artifacts
models/*
!models/.gitkeep
*.joblib
*.pkl
*.pt
*.pth

# Secrets
.env
.env.*
!.env.example

# Experiment outputs
mlruns/
reports/tree_v2_12/train_features.npy
reports/tree_v2_12/validation_features.npy
